# ===========================================
# Finance Control - Environment Variables
# ===========================================

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Finance Control"

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finance_control?schema=public"

# Authentication
# Generate with: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Encryption (for sensitive data at rest)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY="your-encryption-key-32-characters"

# External APIs (optional)
# Open Finance / Open Banking Brasil
OPEN_BANKING_CLIENT_ID=""
OPEN_BANKING_CLIENT_SECRET=""
OPEN_BANKING_REDIRECT_URI=""

# Market Data APIs
YAHOO_FINANCE_API_KEY=""
B3_API_KEY=""
ALPHA_VANTAGE_API_KEY=""

# Email (for notifications)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@financecontrol.com"

# Redis (for caching - optional)
REDIS_URL=""

# Sentry (for error tracking - optional)
SENTRY_DSN=""

# Feature Flags
FEATURE_INVESTMENTS_ENABLED=true
FEATURE_OPEN_BANKING_ENABLED=false
FEATURE_MULTI_CURRENCY_ENABLED=true
